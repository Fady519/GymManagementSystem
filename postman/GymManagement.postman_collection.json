{
  "info": {
    "name": "Gym Management API",
    "description": "Requests for the Gym Management REST API. Select the 'Gym Management - Local' environment first (baseUrl = https://localhost:7080; https is needed for the Secure refresh cookie). Run 'Auth > Login' first: it saves the access token, and every request sends it as a Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (SuperAdmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.environment.set('accessToken', pm.response.json().accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Register member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.environment.set('accessToken', pm.response.json().accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ahmed Ali\",\n  \"email\": \"ahmed{{$randomInt}}@example.com\",\n  \"phone\": \"01098765432\",\n  \"password\": \"Member@123\",\n  \"dateOfBirth\": \"2000-05-20\",\n  \"gender\": \"Male\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Refresh (uses the cookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["if (pm.response.code === 200) { pm.environment.set('accessToken', pm.response.json().accessToken); }"]
              }
            }
          ],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/api/auth/refresh" }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Old@12345\",\n  \"newPassword\": \"New@12345\"\n}" },
            "url": "{{baseUrl}}/api/auth/change-password"
          }
        },
        {
          "name": "Logout",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Users (SuperAdmin)",
      "item": [
        {
          "name": "List users",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users?page=1&pageSize=20" }
        },
        {
          "name": "Create admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["if (pm.response.code === 201) { pm.environment.set('userId', pm.response.json().user.id); }"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Reception Admin\",\n  \"email\": \"admin{{$randomInt}}@example.com\"\n}" },
            "url": "{{baseUrl}}/api/users/admins"
          }
        },
        {
          "name": "Disable user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": "{{baseUrl}}/api/users/{{userId}}/status"
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "List plans",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/plans", "host": ["{{baseUrl}}"], "path": ["api", "plans"] } }
        },
        {
          "name": "List active plans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/plans?isActive=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plans"],
              "query": [{ "key": "isActive", "value": "true" }]
            }
          }
        },
        {
          "name": "Get plan by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/plans/{{planId}}" }
        },
        {
          "name": "Create plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.environment.set('planId', pm.response.json().id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student Plan {{$randomInt}}\",\n  \"description\": \"Gym access for students with a valid ID\",\n  \"durationDays\": 30,\n  \"price\": 250\n}"
            },
            "url": "{{baseUrl}}/api/plans"
          }
        },
        {
          "name": "Create plan (invalid -> 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"x\",\n  \"description\": \"\",\n  \"durationDays\": 0,\n  \"price\": -5\n}" },
            "url": "{{baseUrl}}/api/plans"
          }
        },
        {
          "name": "Update plan",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student Plan Plus {{$randomInt}}\",\n  \"description\": \"Gym access and 2 classes per week for students\",\n  \"durationDays\": 30,\n  \"price\": 320\n}"
            },
            "url": "{{baseUrl}}/api/plans/{{planId}}"
          }
        },
        {
          "name": "Deactivate plan",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": "{{baseUrl}}/api/plans/{{planId}}/status"
          }
        },
        {
          "name": "Activate plan",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": true\n}" },
            "url": "{{baseUrl}}/api/plans/{{planId}}/status"
          }
        },
        {
          "name": "Delete plan",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/plans/{{planId}}" }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories (public)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/categories" }
        },
        {
          "name": "Create category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.environment.set('categoryId', pm.response.json().id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Pilates {{$randomInt}}\"\n}" },
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "Update category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Pilates Plus {{$randomInt}}\"\n}" },
            "url": "{{baseUrl}}/api/categories/{{categoryId}}"
          }
        },
        {
          "name": "Delete category (409 if trainers use it)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/categories/{{categoryId}}" }
        }
      ]
    },
    {
      "name": "Trainers",
      "item": [
        {
          "name": "List trainers (search + category filter)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/trainers?search=&categoryId=&page=1&pageSize=20" }
        },
        {
          "name": "Get trainer by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/trainers/{{trainerId}}" }
        },
        {
          "name": "Create trainer (returns temporary password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.environment.set('trainerId', pm.response.json().trainer.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mahmoud Hassan\",\n  \"email\": \"coach{{$randomInt}}@example.com\",\n  \"phone\": \"0112{{$randomInt}}{{$randomInt}}\",\n  \"dateOfBirth\": \"1990-04-12\",\n  \"gender\": \"Male\",\n  \"categoryId\": {{categoryId}},\n  \"address\": { \"buildingNumber\": 10, \"street\": \"Makram Ebeid\", \"city\": \"Nasr City\" }\n}" },
            "url": "{{baseUrl}}/api/trainers"
          }
        },
        {
          "name": "Update trainer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mahmoud Hassan\",\n  \"email\": \"coach.updated{{$randomInt}}@example.com\",\n  \"phone\": \"0122{{$randomInt}}{{$randomInt}}\",\n  \"dateOfBirth\": \"1990-04-12\",\n  \"gender\": \"Male\",\n  \"categoryId\": {{categoryId}},\n  \"address\": null\n}" },
            "url": "{{baseUrl}}/api/trainers/{{trainerId}}"
          }
        },
        {
          "name": "Create login account (old trainers)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/trainers/{{trainerId}}/account" }
        },
        {
          "name": "Delete trainer (409 if upcoming sessions)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/trainers/{{trainerId}}" }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List members (search, filters, sort, paging)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/members?search=&gender=&membershipState=&sortBy=CreatedAt&descending=true&page=1&pageSize=20" }
        },
        {
          "name": "Get member by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/members/{{memberId}}" }
        },
        {
          "name": "Create member (with health record)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.environment.set('memberId', pm.response.json().id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"محمد أحمد\",\n  \"email\": \"member{{$randomInt}}@example.com\",\n  \"phone\": \"0101{{$randomInt}}{{$randomInt}}\",\n  \"dateOfBirth\": \"2001-09-01\",\n  \"gender\": \"Male\",\n  \"address\": { \"buildingNumber\": 3, \"street\": \"El Tahrir\", \"city\": \"Giza\" },\n  \"healthRecord\": { \"height\": 175, \"weight\": 78, \"bloodType\": \"B+\", \"note\": \"Knee injury in 2023\" }\n}" },
            "url": "{{baseUrl}}/api/members"
          }
        },
        {
          "name": "Update member",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"محمد أحمد علي\",\n  \"email\": \"member.updated{{$randomInt}}@example.com\",\n  \"phone\": \"0155{{$randomInt}}{{$randomInt}}\",\n  \"dateOfBirth\": \"2001-09-01\",\n  \"gender\": \"Male\",\n  \"address\": null\n}" },
            "url": "{{baseUrl}}/api/members/{{memberId}}"
          }
        },
        {
          "name": "Save health record",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"height\": 175,\n  \"weight\": 74,\n  \"bloodType\": \"B+\",\n  \"note\": \"Lost 4 kg\"\n}" },
            "url": "{{baseUrl}}/api/members/{{memberId}}/health-record"
          }
        },
        {
          "name": "Upload photo (choose a JPG/PNG/WEBP in Body > form-data)",
          "request": {
            "method": "PUT",
            "body": { "mode": "formdata", "formdata": [{ "key": "photo", "type": "file", "src": [] }] },
            "url": "{{baseUrl}}/api/members/{{memberId}}/photo"
          }
        },
        {
          "name": "Delete photo",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/members/{{memberId}}/photo" }
        },
        {
          "name": "Delete member (409 if active membership / upcoming bookings)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/members/{{memberId}}" }
        }
      ]
    }
  ]
}
