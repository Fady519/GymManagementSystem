              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Reception Admin\",\n  \"email\": \"admin{{$randomInt}}@example.com\"\n}" },
            "url": "{{baseUrl}}/api/users/admins"
          }
        },
        {
          "name": "Resend invite (only while the password isn't set)",
