{
  "info": {
    "name": "Gym Management API",
    "description": "Requests for the Gym Management REST API. Select the 'Gym Management - Local' environment first (baseUrl = https://localhost:7080; https is needed for the Secure refresh cookie). Run 'Auth > Login' first: it saves the access token, and every request sends it as a Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (SuperAdmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.environment.set('accessToken', pm.response.json().accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Register member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.environment.set('accessToken', pm.response.json().accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ahmed Ali\",\n  \"email\": \"ahmed{{$randomInt}}@example.com\",\n  \"phone\": \"01098765432\",\n  \"password\": \"Member@123\",\n  \"dateOfBirth\": \"2000-05-20\",\n  \"gender\": \"Male\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Refresh (uses the cookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["if (pm.response.code === 200) { pm.environment.set('accessToken', pm.response.json().accessToken); }"]
              }
            }
          ],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/api/auth/refresh" }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Old@12345\",\n  \"newPassword\": \"New@12345\"\n}" },
            "url": "{{baseUrl}}/api/auth/change-password"
          }
        },
        {
          "name": "Logout",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Users (SuperAdmin)",
      "item": [
        {
          "name": "List users",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users?page=1&pageSize=20" }
        },
        {
          "name": "Create admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["if (pm.response.code === 201) { pm.environment.set('userId', pm.response.json().user.id); }"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Reception Admin\",\n  \"email\": \"admin{{$randomInt}}@example.com\"\n}" },
            "url": "{{baseUrl}}/api/users/admins"
          }
        },
        {
          "name": "Disable user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": "{{baseUrl}}/api/users/{{userId}}/status"
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "List plans",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/plans", "host": ["{{baseUrl}}"], "path": ["api", "plans"] } }
        },
        {
          "name": "List active plans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/plans?isActive=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plans"],
              "query": [{ "key": "isActive", "value": "true" }]
            }
          }
        },
        {
          "name": "Get plan by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/plans/{{planId}}" }
        },
        {
          "name": "Create plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.environment.set('planId', pm.response.json().id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student Plan {{$randomInt}}\",\n  \"description\": \"Gym access for students with a valid ID\",\n  \"durationDays\": 30,\n  \"price\": 250\n}"
            },
            "url": "{{baseUrl}}/api/plans"
          }
        },
        {
          "name": "Create plan (invalid -> 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"x\",\n  \"description\": \"\",\n  \"durationDays\": 0,\n  \"price\": -5\n}" },
            "url": "{{baseUrl}}/api/plans"
          }
        },
        {
          "name": "Update plan",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student Plan Plus {{$randomInt}}\",\n  \"description\": \"Gym access and 2 classes per week for students\",\n  \"durationDays\": 30,\n  \"price\": 320\n}"
            },
            "url": "{{baseUrl}}/api/plans/{{planId}}"
          }
        },
        {
          "name": "Deactivate plan",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": "{{baseUrl}}/api/plans/{{planId}}/status"
          }
        },
        {
          "name": "Activate plan",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": true\n}" },
            "url": "{{baseUrl}}/api/plans/{{planId}}/status"
          }
        },
        {
          "name": "Delete plan",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/plans/{{planId}}" }
        }
      ]
    }
  ]
}
