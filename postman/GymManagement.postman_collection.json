{
  "info": {
    "name": "Gym Management API",
    "description": "Requests for the Gym Management REST API. Select the 'Gym Management - Local' environment first (baseUrl = https://localhost:7080; https is needed for the Secure refresh cookie). Run 'Auth > Login' first: it saves the access token, and every request sends it as a Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A new valid Egyptian mobile number before every request, so create requests never collide",
          "// with data from an earlier run (the Runner can be run again and again).",
          "pm.variables.set('randomPhone', '010' + Math.floor(10000000 + Math.random() * 90000000));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after EVERY request: simple checks that every endpoint must pass.",
          "pm.test('No server error (status < 500)', () => pm.expect(pm.response.code).to.be.below(500));",
          "const type = pm.response.headers.get('Content-Type') || '';",
          "if (pm.response.code >= 400) {",
          "  pm.test('Errors are Problem Details (RFC 9457)', () => {",
          "    pm.expect(type).to.include('application/problem+json');",
          "    const problem = pm.response.json();",
          "    pm.expect(problem).to.have.property('status', pm.response.code);",
          "    pm.expect(problem).to.have.property('title');",
          "  });",
          "} else if (type.includes('application/json')) {",
          "  pm.test('Body is valid JSON', () => pm.response.json());",
          "}",
          "pm.test('Security headers are present', () => {",
          "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
          "  pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (SuperAdmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.environment.set('accessToken', pm.response.json().accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Refresh (uses the cookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["if (pm.response.code === 200) { pm.environment.set('accessToken', pm.response.json().accessToken); }"]
              }
            }
          ],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/api/auth/refresh" }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Old@12345\",\n  \"newPassword\": \"New@12345\"\n}" },
            "url": "{{baseUrl}}/api/auth/change-password"
          }
        },
        {
          "name": "Logout",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        },
        {
          "name": "Register member (a new random member; placed after Logout so its refresh cookie does not replace the SuperAdmin one)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created with a token', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().accessToken).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ahmed Ali\",\n  \"email\": \"ahmed{{$timestamp}}@example.com\",\n  \"phone\": \"{{randomPhone}}\",\n  \"password\": \"Member@123\",\n  \"dateOfBirth\": \"2000-05-20\",\n  \"gender\": \"Male\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Forgot password (same answer even for unknown emails)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{superAdminEmail}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/forgot-password"
          }
        },
        {
          "name": "Reset password (paste the token from the email link)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"token\": \"PASTE_TOKEN_FROM_EMAIL\",\n  \"newPassword\": \"New@Pass123\"\n}" },
            "url": "{{baseUrl}}/api/auth/reset-password"
          }
        },
        {
          "name": "Accept invite (choose the first password)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"PASTE_EMAIL_FROM_LINK\",\n  \"token\": \"PASTE_TOKEN_FROM_EMAIL\",\n  \"password\": \"MyOwn@Pass1\"\n}" },
            "url": "{{baseUrl}}/api/auth/accept-invite"
          }
        }
      ]
    },
    {
      "name": "Users (SuperAdmin)",
      "item": [
        {
          "name": "List users",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users?page=1&pageSize=20" }
        },
        {
          "name": "Create admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
