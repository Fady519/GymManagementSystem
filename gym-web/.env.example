# Copy this file to .env.local and change the values if needed.

# Where the ASP.NET Core API runs (used by the Next.js server for the /api and /uploads rewrites).
API_URL=https://localhost:7080

# The public address of this website. Used for SEO: canonical links, the sitemap and
# link previews on WhatsApp / Facebook (Open Graph). Change it to the real domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, for the public demo only: the password of the seeded demo accounts
# (admin@demo.gym, trainer@demo.gym, member@demo.gym). When set, the login page shows
# one-click "Admin / Trainer / Member" demo buttons. Leave it empty for a real gym.
NEXT_PUBLIC_DEMO_PASSWORD=
