<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seed JSON files are copied to bin/.../SeedData so seeding works from any working directory. -->
    <None Update="Data\SeedData\Files\*.json" CopyToOutputDirectory="PreserveNewest" Link="SeedData\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
